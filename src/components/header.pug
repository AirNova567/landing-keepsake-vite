input#nav-toggle.nav-toggle(type='checkbox', aria-controls='site-nav', aria-label='Toggle menu')
header.header
  .header__inner
    a.logo-link(href='#top', aria-label=`${site.name} home`)
      span.logo-link__mark K
      span.logo-link__text eepsake
    label.burger(for='nav-toggle')
      each line in [1, 2, 3]
        span.burger__line
    nav#site-nav.nav(aria-label='Main navigation')
      ul.nav__list
        each link in navLinks
          li
            a.nav__link(
              class={ 'nav__link--active': link.active },
              href=link.href,
              aria-current=link.active ? 'page' : false
            )
              | #{ link.text }
              +icon('chev')
      .nav__actions
        +btn('Contact us', '#contact', 'primary').nav__contact
          +icon('mail')
        +btn('', '#', 'secondary').nav__fav(aria-label='Favourites')
          +icon('heart')
          span.nav__fav-text Favourites
      .nav__contacts
        p.nav__hello Say hello
        a.nav__mail(href=`mailto:${site.email}`) #{ site.email }
        a.nav__phone(href=`tel:${site.phone}`) #{ site.phoneLabel }
        +socials
