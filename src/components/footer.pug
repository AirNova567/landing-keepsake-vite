footer#contact.footer
  .container
    .footer__top
      .footer__cols
        each column in footerColumns
          .footer__col
            h2.footer__heading #{ column.title }
            ul.footer__list
              each link in column.links
                li
                  a(href='#') #{ link }
      #newsletter.newsletter
        form.newsletter__form(action='#subscribed', method='get')
          h2.newsletter__title Newsletter
          p.newsletter__text Fresh case studies and design notes, once a month.
          .newsletter__field
            .newsletter__row
              label.visually-hidden(for='email') Your email address
              input#email.newsletter__input(
                type='email',
                name='email',
                placeholder='Your email address',
                required,
                aria-describedby='email-error'
              )
              button.btn.btn--primary.newsletter__btn(type='submit') Subscribe
            p#email-error.newsletter__error Please enter a valid email address.
          .newsletter__consent
            input#consent.newsletter__check(type='checkbox', name='consent', required)
            label(for='consent') I agree to the privacy policy
        #subscribed.newsletter__success(tabindex='-1')
          h2.newsletter__title Thank you!
          p.newsletter__text You are subscribed. Check your inbox for a confirmation email.
    hr.footer__divider
    .footer__bottom
      +socials
      p.footer__copy © #{ site.year } #{ site.name }. All rights reserved.

a.to-top(href='#top', aria-label='Back to top')
  +icon('up')
